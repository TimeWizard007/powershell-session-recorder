<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerShellSessionRecorder.App.ViewModels"
             xmlns:loc="using:PowerShellSessionRecorder.App.Localization"
             x:Class="PowerShellSessionRecorder.App.Views.SessionSetupView"
             x:DataType="vm:SessionSetupViewModel"
             x:CompileBindings="True">
  <StackPanel MaxWidth="860" HorizontalAlignment="Left" Spacing="16">
    <Border Classes="card">
      <StackPanel Spacing="14">
        <TextBlock Classes="section" Text="{loc:Tr SectionSession}" />

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr FieldCustomerTag}" />
          <ComboBox ItemsSource="{Binding Customers.Choices}"
                    SelectedItem="{Binding Customers.SelectedCustomer}"
                    PlaceholderText="{loc:Tr CustomerSelectPlaceholder}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CustomerChoice">
                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button MinHeight="42"
                    Margin="0,0,8,8"
                    Content="{loc:Tr CustomerAdd}"
                    Command="{Binding Customers.BeginAddCommand}" />
            <Button MinHeight="42"
                    Margin="0,0,8,8"
                    Content="{loc:Tr CustomerManage}"
                    Command="{Binding Customers.ToggleManageCommand}"
                    IsVisible="{Binding !Customers.IsManaging}" />
            <Button MinHeight="42"
                    Margin="0,0,8,8"
                    Content="{loc:Tr CustomerHide}"
                    Command="{Binding Customers.ToggleManageCommand}"
                    IsVisible="{Binding Customers.IsManaging}" />
          </WrapPanel>
          <TextBlock Foreground="{DynamicResource AppText}"
                     Text="{Binding Customers.SelectedTagText}"
                     TextWrapping="Wrap" />
          <TextBlock Classes="error"
                     Text="{Binding CustomerTagError}"
                     IsVisible="{Binding HasCustomerTagError}" />
          <TextBlock Classes="error"
                     Text="{Binding Customers.CatalogWarning}"
                     IsVisible="{Binding Customers.HasCatalogWarning}" />
          <TextBlock Foreground="{DynamicResource AppText}"
                     Text="{Binding Customers.StatusMessage}"
                     TextWrapping="Wrap"
                     IsVisible="{Binding Customers.HasStatusMessage}" />
        </StackPanel>

        <Border Classes="card" IsVisible="{Binding Customers.IsAdding}">
          <StackPanel Spacing="8">
            <TextBlock Classes="label" Text="{loc:Tr CustomerAdd}" />
            <TextBox Text="{Binding Customers.NewTag}" PlaceholderText="{loc:Tr PlaceholderCustomerTag}" />
            <TextBlock Classes="label" Text="{loc:Tr CustomerDisplayName}" />
            <TextBox Text="{Binding Customers.NewDisplayName}" PlaceholderText="{loc:Tr CustomerDisplayNameHint}" />
            <TextBlock Classes="hint" Text="{loc:Tr CustomerDisplayNameHint}" TextWrapping="Wrap" />
            <TextBlock Classes="error" Text="{Binding Customers.FormError}" IsVisible="{Binding Customers.HasFormError}" />
            <WrapPanel Orientation="Horizontal">
              <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerSave}" Command="{Binding Customers.SaveNewCommand}" />
              <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerCancel}" Command="{Binding Customers.CancelAddCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding Customers.ShowEmpty}">
          <StackPanel Spacing="8">
            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr CustomerEmptyTitle}" />
            <TextBlock Classes="hint" Text="{loc:Tr CustomerEmptyBody}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding Customers.IsManaging}">
          <StackPanel Spacing="10">
            <TextBlock Classes="label" Text="{loc:Tr CustomerSearch}" />
            <TextBox Text="{Binding Customers.SearchText}" PlaceholderText="{loc:Tr CustomerSearch}" />
            <TextBlock Classes="hint" Text="{loc:Tr CustomerNoMatches}" IsVisible="{Binding Customers.ShowNoMatches}" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding Customers.VisibleCustomers}" IsVisible="{Binding Customers.ShowCustomerList}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CustomerChoice">
                  <StackPanel Margin="0,0,0,8" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource AppText}" Text="{Binding Label}" TextWrapping="Wrap" />
                    <WrapPanel Orientation="Horizontal">
                      <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerEdit}" Command="{Binding EditCommand}" />
                      <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerRemove}" Command="{Binding RemoveCommand}" />
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding Customers.IsEditing}">
              <StackPanel Spacing="8">
                <TextBlock Classes="label" Text="{loc:Tr CustomerEdit}" />
                <TextBox Text="{Binding Customers.EditTag}" />
                <TextBlock Classes="label" Text="{loc:Tr CustomerDisplayName}" />
                <TextBox Text="{Binding Customers.EditDisplayName}" />
                <TextBlock Classes="hint" Text="{loc:Tr CustomerDisplayNameHint}" TextWrapping="Wrap" />
                <TextBlock Classes="error" Text="{Binding Customers.FormError}" IsVisible="{Binding Customers.HasFormError}" />
                <WrapPanel Orientation="Horizontal">
                  <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerSave}" Command="{Binding Customers.SaveEditCommand}" />
                  <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerCancel}" Command="{Binding Customers.CancelEditCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding Customers.HasPendingRemoval}">
              <StackPanel Spacing="8">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr CustomerRemoveTitle}" />
                <TextBlock Classes="hint" Text="{Binding Customers.PendingRemovalBody}" TextWrapping="Wrap" />
                <WrapPanel Orientation="Horizontal">
                  <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerConfirmRemove}" Command="{Binding Customers.ConfirmRemoveCommand}" />
                  <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr CustomerCancel}" Command="{Binding Customers.CancelRemoveCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr FieldSessionName}" />
          <TextBox Text="{Binding SessionName, Mode=TwoWay}"
                   PlaceholderText="{loc:Tr PlaceholderSessionName}" />
          <TextBlock Classes="error"
                     Text="{Binding SessionNameError}"
                     IsVisible="{Binding HasSessionNameError}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr FieldLogDirectory}" />
          <TextBox Text="{Binding LogDirectory, Mode=TwoWay}"
                   PlaceholderText="{loc:Tr TooltipBrowse}" />
          <WrapPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button MinHeight="42"
                    Margin="0,0,8,8"
                    Content="{loc:Tr ButtonBrowse}"
                    Command="{Binding BrowseLogDirectoryCommand}"
                    ToolTip.Tip="{loc:Tr TooltipBrowse}" />
            <Button MinHeight="42"
                    Margin="0,0,8,8"
                    Content="{loc:Tr NavOpenLogFolder}"
                    Command="{Binding OpenLogFolderCommand}"
                    ToolTip.Tip="{loc:Tr TooltipOpenLogFolder}" />
          </WrapPanel>
          <TextBlock Classes="error"
                     Text="{Binding LogDirectoryError}"
                     IsVisible="{Binding HasLogDirectoryError}" />
          <TextBlock Classes="hint"
                     Text="{Binding LogDirectoryHint}"
                     IsVisible="{Binding HasLogDirectoryHint}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr FieldPowerShellVersion}" />
          <ComboBox ItemsSource="{Binding PowerShellChoices}"
                    SelectedItem="{Binding SelectedPowerShellChoice, Mode=TwoWay}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PowerShellChoice">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint"
                     Text="{loc:Tr WindowsPowerShell51Note}"
                     IsVisible="{Binding ShowWindowsPowerShellNote}" />
          <TextBlock Classes="hint"
                     Text="{Binding SelectedEngineMissingText}"
                     IsVisible="{Binding ShowSelectedEngineMissing}" />
        </StackPanel>

        <StackPanel Spacing="4" IsVisible="{Binding ShowElevationOption}">
          <CheckBox IsChecked="{Binding RunAsAdministrator, Mode=TwoWay}"
                    Content="{loc:Tr FieldRunAsAdministrator}"
                    ToolTip.Tip="{loc:Tr TooltipRunAsAdministrator}" />
          <TextBlock Classes="hint" Text="{loc:Tr FieldRunAsAdministratorHint}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding IncludeDateAndTime, Mode=TwoWay}"
                    Content="{loc:Tr FieldIncludeDateAndTime}"
                    ToolTip.Tip="{loc:Tr TooltipIncludeDateAndTime}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <CheckBox IsChecked="{Binding SaveSessionInHistory, Mode=TwoWay}"
                    Content="{loc:Tr FieldSaveInHistory}"
                    ToolTip.Tip="{loc:Tr TooltipSaveInHistory}" />
          <TextBlock Classes="hint" Text="{loc:Tr FieldSaveInHistoryHint}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="{loc:Tr SectionPreview}" />
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
          <TextBlock Grid.Row="0" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewCustomerTag}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="0" Grid.Column="1" Classes="preview-value" Text="{Binding PreviewCustomerTag}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewSessionName}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="preview-value" Text="{Binding PreviewSessionName}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewPowerShellVersion}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="2" Grid.Column="1" Classes="preview-value" Text="{Binding PreviewPowerShellVersion}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewPrivilegeMode}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="3" Grid.Column="1" Classes="preview-value" Text="{Binding PreviewPrivilege}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="4" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewLogDirectory}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="4" Grid.Column="1" Classes="preview-value" Text="{Binding PreviewLogDirectory}" TextWrapping="Wrap" />
          <TextBlock Grid.Row="5" Grid.Column="0" MaxWidth="220" Classes="preview-label" Text="{loc:Tr PreviewFileName}" TextWrapping="Wrap" />
          <TextBox Grid.Row="5"
                   Grid.Column="1"
                   Text="{Binding ProposedFileName}"
                   IsReadOnly="True"
                   TextWrapping="Wrap"
                   Background="Transparent"
                   BorderThickness="0" />
        </Grid>
        <TextBlock Classes="hint" Text="{loc:Tr PreviewFilenameNote}" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="12">
      <Button Classes="primary"
              HorizontalAlignment="Left"
              Content="{loc:Tr NavStartSession}"
              IsEnabled="{Binding CanStartSession}"
              Command="{Binding StartSessionCommand}"
              ToolTip.Tip="{Binding StartSessionTooltip}" />
      <TextBlock Classes="hint" Text="{Binding StartSessionHint}" />
      <TextBlock Classes="hint"
                 Foreground="{DynamicResource AppText}"
                 Text="{Binding ActivityMessage}"
                 IsVisible="{Binding HasActivityMessage}" />

      <Border Classes="notice" IsVisible="{Binding ShowDependencyNotice}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="4" IsVisible="{Binding ShowUnsupportedPlatform}">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr DependencyUnsupportedPlatform}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding ShowPowerShellMissing}">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr DependencyPowerShellMissing}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{loc:Tr DependencyPowerShellInstall}" />
            <Button HorizontalAlignment="Left"
                    Content="{loc:Tr ButtonOpenPowerShellDocs}"
                    Command="{Binding OpenPowerShellInstallDocsCommand}" />
          </StackPanel>
          <StackPanel Spacing="4" IsVisible="{Binding ShowTerminalMissing}">
            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr DependencyTerminalMissing}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{loc:Tr DependencyTerminalInstall}" />
            <TextBox Text="{Binding UbuntuTerminalInstallCommand}" IsReadOnly="True" />
          </StackPanel>
          <Button HorizontalAlignment="Left"
                  Content="{loc:Tr ButtonRefreshDependencies}"
                  Command="{Binding RefreshDependenciesCommand}"
                  IsVisible="{Binding ShowDependencyRefresh}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
