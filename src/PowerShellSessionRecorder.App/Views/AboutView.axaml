<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerShellSessionRecorder.App.ViewModels"
             xmlns:loc="using:PowerShellSessionRecorder.App.Localization"
             x:Class="PowerShellSessionRecorder.App.Views.AboutView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">
  <Border Classes="card" MaxWidth="760" HorizontalAlignment="Stretch">
    <StackPanel Spacing="16">
      <TextBlock Classes="section" Text="{loc:Tr SectionAbout}" />
      <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr AppTitle}" />
      <TextBlock Classes="hint" Text="{loc:Tr AboutDescription}" />

      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="{loc:Tr AboutVersion}" />
        <TextBlock FontSize="14" Foreground="{DynamicResource AppText}" Text="{Binding ApplicationVersion}" />
      </StackPanel>

      <TextBlock Classes="hint" Text="{loc:Tr AboutLicense}" />
      <TextBlock Classes="hint" Text="{loc:Tr AboutLimitations}" />

      <StackPanel Spacing="4">
        <TextBlock Classes="label" Text="{loc:Tr AboutOpenRepository}" />
        <TextBox Text="{Binding RepositoryUrl}" IsReadOnly="True" />
        <Button HorizontalAlignment="Left"
                Content="{loc:Tr AboutOpenRepository}"
                Command="{Binding OpenRepositoryCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
