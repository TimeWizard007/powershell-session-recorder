<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerShellSessionRecorder.App.ViewModels"
             xmlns:loc="using:PowerShellSessionRecorder.App.Localization"
             x:Class="PowerShellSessionRecorder.App.Views.HistoryView"
             x:DataType="vm:HistoryViewModel"
             x:CompileBindings="True">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <TextBlock Classes="section" Text="{loc:Tr SectionHistory}" />
      <TextBlock Classes="hint" Text="{loc:Tr HistoryStatusHelp}" />
      <TextBlock Classes="error"
                 Text="{Binding StoreWarning}"
                 IsVisible="{Binding HasStoreWarning}" />
      <TextBlock Foreground="{DynamicResource AppText}"
                 Text="{Binding ActionMessage}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding HasActionMessage}" />
      <WrapPanel Orientation="Horizontal">
        <StackPanel Width="220" Margin="0,0,8,8" Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr HistorySearch}" />
          <TextBox Text="{Binding SearchText}" PlaceholderText="{loc:Tr HistorySearch}" />
        </StackPanel>
        <StackPanel Width="180" Margin="0,0,8,8" Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr HistoryTagFilter}" />
          <ComboBox ItemsSource="{Binding TagFilters}"
                    SelectedItem="{Binding SelectedTag}"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:TagFilterOption">
                <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Width="160" Margin="0,0,8,8" Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr HistoryFromDate}" />
          <CalendarDatePicker SelectedDate="{Binding FromDate}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Width="160" Margin="0,0,8,8" Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr HistoryToDate}" />
          <CalendarDatePicker SelectedDate="{Binding ToDate}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <Button MinHeight="42"
                Margin="0,24,8,8"
                VerticalAlignment="Bottom"
                Content="{loc:Tr HistoryClearFilters}"
                Command="{Binding ClearFiltersCommand}" />
        <Button MinHeight="42"
                Margin="0,24,8,8"
                VerticalAlignment="Bottom"
                Content="{loc:Tr HistoryRefresh}"
                Command="{Binding RefreshCommand}" />
      </WrapPanel>
      <WrapPanel Orientation="Horizontal" IsVisible="{Binding ShowList}">
        <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistorySelectAll}" Command="{Binding SelectAllShownCommand}" />
        <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryClearSelection}" Command="{Binding ClearSelectionCommand}" />
        <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryRemoveOnly}" Command="{Binding AskRemoveSelectedHistoryCommand}" />
        <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryRemoveAndFile}" Command="{Binding AskRemoveSelectedFilesCommand}" />
        <TextBlock Margin="0,8,8,8" VerticalAlignment="Center" Classes="hint" Text="{Binding SelectionCountText}" TextWrapping="Wrap" />
      </WrapPanel>
      <Border Classes="card" IsVisible="{Binding HasPendingCleanup}">
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource AppText}" Text="{loc:Tr HistoryCleanupTitle}" />
          <TextBlock Classes="hint" Text="{Binding PendingCleanupSummary}" TextWrapping="Wrap" />
          <WrapPanel Orientation="Horizontal">
            <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryCleanupConfirm}" Command="{Binding ConfirmCleanupCommand}" />
            <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryCleanupCancel}" Command="{Binding CancelCleanupCommand}" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </StackPanel>

    <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding ShowEmpty}">
      <StackPanel Spacing="8">
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppText}"
                   Text="{loc:Tr HistoryEmptyTitle}" />
        <TextBlock Classes="hint" FontSize="14" Text="{loc:Tr HistoryEmptyBody}" />
      </StackPanel>
    </Border>

    <Border Classes="card" Margin="0,16,0,0" IsVisible="{Binding ShowNoMatches}">
      <StackPanel Spacing="8">
        <TextBlock FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource AppText}"
                   Text="{loc:Tr HistoryNoMatchesTitle}" />
        <TextBlock Classes="hint" FontSize="14" Text="{loc:Tr HistoryNoMatchesBody}" />
      </StackPanel>
    </Border>

    <ListBox Margin="0,16,0,0"
             Padding="0"
             Background="Transparent"
             BorderThickness="0"
             IsVisible="{Binding ShowList}"
             ItemsSource="{Binding Entries}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="0,0,0,10" />
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:HistoryEntryViewModel">
          <Border Classes="card" Padding="16">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <CheckBox Grid.Column="0"
                        VerticalAlignment="Top"
                        Content="{loc:Tr HistorySelect}"
                        IsChecked="{Binding IsSelected}" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
              <TextBlock FontSize="16"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource AppText}"
                         Text="{Binding CustomerTag}" />
              <TextBlock Grid.Column="1"
                         Classes="hint"
                         Text="{Binding PowerShellText}" />
              <TextBlock Grid.Row="1"
                         Margin="0,4,0,0"
                         Foreground="{DynamicResource AppText}"
                         Text="{Binding SessionName}"
                         TextWrapping="Wrap" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="16,4,0,0"
                         MaxWidth="280"
                         Classes="hint"
                         IsVisible="{Binding !StatusIsMissing}"
                         Text="{Binding StatusText}"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{Binding StatusToolTip}" />
              <TextBlock Grid.Row="1"
                         Grid.Column="1"
                         Margin="16,4,0,0"
                         MaxWidth="280"
                         Classes="error"
                         IsVisible="{Binding StatusIsMissing}"
                         Text="{Binding StatusText}"
                         TextWrapping="Wrap"
                         ToolTip.Tip="{Binding StatusToolTip}" />
              <TextBlock Grid.Row="2"
                         Grid.ColumnSpan="2"
                         Margin="0,8,0,0"
                         Classes="hint"
                         Text="{Binding StartedLocalText}" />
              <TextBlock Grid.Row="3"
                         Grid.ColumnSpan="2"
                         Classes="hint"
                         IsVisible="{Binding HasEnded}"
                         Text="{Binding EndedLocalText}" />
              <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,8,0,0" Spacing="2">
                <TextBlock Foreground="{DynamicResource AppText}"
                           Text="{Binding TranscriptFileName}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="hint"
                           Text="{Binding TranscriptPath}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip.Tip="{Binding TranscriptPath}" />
              </StackPanel>
              <WrapPanel Grid.Row="5"
                         Grid.ColumnSpan="2"
                         Margin="0,12,0,0"
                         Orientation="Horizontal">
                <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryOpenTranscript}" Command="{Binding OpenTranscriptCommand}" />
                <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryOpenFolder}" Command="{Binding OpenFolderCommand}" />
                <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryCopyPath}" Command="{Binding CopyPathCommand}" />
                <Button MinHeight="42" Margin="0,0,8,8" Content="{loc:Tr HistoryRemoveOnly}" Command="{Binding RemoveFromHistoryCommand}" />
                <Button MinHeight="42"
                        Margin="0,0,8,8"
                        Content="{loc:Tr HistoryRemoveAndFile}"
                        Command="{Binding RemoveAndDeleteFileCommand}"
                        ToolTip.Tip="{Binding DeleteFileToolTip}" />
              </WrapPanel>
              </Grid>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
