<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PowerShellSessionRecorder.App.ViewModels"
             xmlns:loc="using:PowerShellSessionRecorder.App.Localization"
             x:Class="PowerShellSessionRecorder.App.Views.SettingsView"
             x:DataType="vm:MainWindowViewModel"
             x:CompileBindings="True">
  <StackPanel MaxWidth="760" HorizontalAlignment="Left" Spacing="16">
    <Border Classes="card">
      <StackPanel Spacing="16">
        <TextBlock Classes="section" Text="{loc:Tr SectionSettings}" />

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr SettingsLanguage}" />
          <ComboBox ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                    MinWidth="160"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:LanguageOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint" Text="{loc:Tr SettingsLanguageHelp}" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr SettingsTheme}" />
          <ComboBox ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                    MinWidth="160"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ThemeOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint" Text="{loc:Tr SettingsThemeHelp}" />
        </StackPanel>

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr SettingsFile}" />
          <TextBox Text="{Binding SettingsFilePath}" IsReadOnly="True" />
        </StackPanel>

        <TextBlock Classes="hint" Text="{loc:Tr SettingsAutoSave}" />
        <TextBlock Classes="hint" Text="{loc:Tr SettingsNoSecrets}" />
        <TextBlock Classes="hint"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatusMessage}" />

        <TextBlock Classes="hint"
                   Text="{loc:Tr SettingsWindowsPowerShellAdjusted}"
                   IsVisible="{Binding WindowsPowerShellWasAdjusted}" />
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBlock Classes="section" Text="{loc:Tr SectionPowerShellVersions}" />
        <TextBlock Classes="hint" Text="{loc:Tr PowerShellVersionsInformational}" TextWrapping="Wrap" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr PowerShellInstalledVersion}" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding PowerShellVersions.InstalledText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr PowerShellLatestVersion}" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding PowerShellVersions.LatestText}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="16">
        <TextBlock Classes="section" Text="{loc:Tr SectionUpdates}" />
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr UpdatesChannel}" />
          <ComboBox ItemsSource="{Binding Updates.Channels}"
                    SelectedItem="{Binding Updates.SelectedChannel, Mode=TwoWay}"
                    MinWidth="160"
                    MaxWidth="360"
                    HorizontalAlignment="Stretch">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:UpdateChannelOption">
                <TextBlock Text="{Binding DisplayName}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Classes="hint" Text="{loc:Tr UpdatesChannelHelp}" TextWrapping="Wrap" />
        </StackPanel>
        <CheckBox IsChecked="{Binding Updates.CheckForUpdatesAutomatically, Mode=TwoWay}"
                  Content="{loc:Tr UpdatesAutomatic}" />
        <TextBlock Classes="hint" Text="{loc:Tr UpdatesAutomaticHelp}" TextWrapping="Wrap" />

        <WrapPanel Orientation="Horizontal">
          <Button MinHeight="42"
                  Margin="0,0,8,8"
                  Content="{loc:Tr UpdatesCheckNow}"
                  Command="{Binding Updates.CheckForUpdatesNowCommand}" />
          <Button MinHeight="42"
                  Margin="0,0,8,8"
                  Content="{loc:Tr UpdateNoticeViewRelease}"
                  Command="{Binding Updates.ViewReleaseCommand}"
                  IsVisible="{Binding Updates.CanOpenReleasePage}" />
        </WrapPanel>
        <TextBlock Classes="hint"
                   Text="{Binding Updates.UpdateCheckMessage}"
                   IsVisible="{Binding Updates.HasUpdateCheckMessage}" />

        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr UpdatesCurrentVersion}" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding Updates.CurrentVersion}" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{Binding Updates.LatestVersionLabel}" TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding Updates.LatestVersionText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr UpdatesAvailableVersion}" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding Updates.AvailableVersionText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Classes="label" Text="{loc:Tr UpdatesLastCheck}" />
          <TextBlock Foreground="{DynamicResource AppText}" Text="{Binding Updates.LastCheckText}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
