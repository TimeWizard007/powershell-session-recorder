<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PowerShellSessionRecorder.App.ViewModels"
        xmlns:loc="using:PowerShellSessionRecorder.App.Localization"
        xmlns:views="using:PowerShellSessionRecorder.App.Views"
        x:Class="PowerShellSessionRecorder.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        x:CompileBindings="True"
        Width="1120"
        Height="780"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app-icon.png"
        Background="{DynamicResource AppBackground}"
        Title="{loc:Tr AppTitle}">
  <Grid ColumnDefinitions="248,*">
    <Border Grid.Column="0"
            Background="{DynamicResource AppNav}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="0,0,1,0"
            Padding="16,24,16,24">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="8,0,8,28">
          <TextBlock Text="{loc:Tr AppTitle}"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppText}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{loc:Tr AppSubtitle}"
                     FontSize="12"
                     Foreground="{DynamicResource AppMuted}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Tr SectionNavigation}"
                     Margin="14,0,14,8"
                     FontSize="12"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource AppMuted}" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsSessionPage}"
                  Command="{Binding ShowSessionCommand}"
                  Content="{loc:Tr NavNewSession}"
                  ToolTip.Tip="{loc:Tr TooltipStartSessionNav}" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsHistoryPage}"
                  Command="{Binding ShowHistoryCommand}"
                  Content="{loc:Tr NavHistory}"
                  ToolTip.Tip="{loc:Tr TooltipHistory}" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsSettingsPage}"
                  Command="{Binding ShowSettingsCommand}"
                  Content="{loc:Tr NavSettings}"
                  ToolTip.Tip="{loc:Tr TooltipSettings}" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsAboutPage}"
                  Command="{Binding ShowAboutCommand}"
                  Content="{loc:Tr NavAbout}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*">
    <Border Grid.Row="0"
            Classes="notice"
            Margin="32,20,32,0"
            IsVisible="{Binding Updates.ShowNotice}"
            AutomationProperties.Name="{loc:Tr UpdateNoticeTitle}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock FontWeight="SemiBold"
                     Foreground="{DynamicResource AppText}"
                     Text="{loc:Tr UpdateNoticeTitle}"
                     TextWrapping="Wrap" />
          <TextBlock Foreground="{DynamicResource AppText}"
                     Text="{Binding Updates.UpdateNoticeBody}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                VerticalAlignment="Center"
                Content="{loc:Tr UpdateNoticeViewRelease}"
                Command="{Binding Updates.ViewReleaseCommand}"
                IsVisible="{Binding Updates.HasReleasePage}" />
        <Button Grid.Column="2"
                VerticalAlignment="Center"
                Content="{loc:Tr UpdateNoticeLater}"
                Command="{Binding Updates.DismissUpdateCommand}" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
    <ScrollViewer Background="{DynamicResource AppBackground}"
                  HorizontalScrollBarVisibility="Disabled"
                  IsVisible="{Binding !IsHistoryPage}"
                  Padding="32,28">
      <Panel>
        <Border IsVisible="{Binding IsSessionPage}">
          <views:SessionSetupView DataContext="{Binding Session}" />
        </Border>
        <Border IsVisible="{Binding IsSettingsPage}">
          <views:SettingsView />
        </Border>
        <Border IsVisible="{Binding IsAboutPage}">
          <views:AboutView />
        </Border>
      </Panel>
    </ScrollViewer>
    <Border IsVisible="{Binding IsHistoryPage}">
      <views:HistoryView DataContext="{Binding History}" Margin="32,28" />
    </Border>
    </Grid>
    </Grid>
  </Grid>
</Window>
